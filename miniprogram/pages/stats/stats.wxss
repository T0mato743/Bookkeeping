.sum-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.sum-item {
  background: #f8fafb;
  border-radius: 10px;
  padding: 10px 8px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.sl { font-size: 11px; color: #7b8794; }
.sv { font-size: 15px; font-weight: 800; }
.sv.in { color: #059669; }
.sv.out { color: #e11d48; }

.fund-line {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
}

.fp { color: #0f766e; }

.bar {
  height: 10px;
  background: #eef0f4;
  border-radius: 999px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999px;
}

.bar-fill.fund { background: linear-gradient(90deg, #0f766e, #14b8a6); }
.bar-fill.safe { background: linear-gradient(90deg, #059669, #34d399); }

.fund-sub {
  font-size: 12px;
  color: #7b8794;
  margin-top: 6px;
}

.chart {
  width: 100%;
  height: 220px;
}
