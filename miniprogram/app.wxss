page {
  background: #f2f4f7;
  color: #16232e;
  font-size: 14px;
}

.card {
  background: #fff;
  border-radius: 16px;
  padding: 16px;
  margin: 12px 16px;
  box-shadow: 0 1px 2px rgba(22, 35, 46, 0.05), 0 4px 16px rgba(22, 35, 46, 0.06);
}

.card-title {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.card-title::before {
  content: '';
  width: 4px;
  height: 14px;
  border-radius: 2px;
  background: #0f766e;
}

.btn-primary {
  background: #0f766e;
  color: #fff;
  border-radius: 12px;
  font-size: 15px;
  font-weight: 700;
  padding: 12px 0;
  text-align: center;
  border: none;
}

.btn-primary::after { border: none; }

.btn-primary[disabled] {
  opacity: 0.5;
  color: #fff;
}

.seg {
  display: flex;
  background: #eef0f4;
  border-radius: 12px;
  padding: 3px;
  margin-bottom: 14px;
}

.seg-btn {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  border-radius: 10px;
  font-size: 13.5px;
  color: #7b8794;
}

.seg-btn.on {
  background: #fff;
  color: #16232e;
  font-weight: 700;
  box-shadow: 0 1px 4px rgba(22, 35, 46, 0.12);
}

.empty {
  color: #7b8794;
  text-align: center;
  padding: 24px 0;
  font-size: 13px;
}

.err-text {
  color: #e11d48;
  font-size: 12.5px;
  padding: 6px 0;
}
